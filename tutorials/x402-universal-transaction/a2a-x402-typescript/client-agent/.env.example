# Google API Key for Gemini
GOOGLE_API_KEY=your-gemini-key-here

# Client Wallet Configuration
# IMPORTANT: This wallet will SPEND tokens. Keep private key secure!
WALLET_PRIVATE_KEY=your-evm-pk-here

SOLANA_PRIVATE_KEY=your-solana-pk-here

# Merchant Agent URL
MERCHANT_AGENT_URL=http://localhost:10000

# Merchant Wallet Address (where payments will be sent)
# This should match the MERCHANT_WALLET_ADDRESS in the merchant agent's .env
MERCHANT_WALLET_ADDRESS=merchant-wallet-address-here

# Client Agent Debug Logging
# Set to 'true' or '1' to enable detailed client agent logs
# Set to 'false' or omit to disable (errors will still be shown)
CLIENT_DEBUG=false

INFURA_API_KEY=infura-api-key

HELIUS_API_KEY=solana-helius-rpc-api-key