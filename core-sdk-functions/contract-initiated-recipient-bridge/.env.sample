# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Sepolia EOA used to deploy the bridge contract and call bridgeToPush.
# Needs ≥ 0.05 Sepolia ETH (deploy + at least one bridge with fee).
PRIVATE_KEY=

# Optional. Skips the deployment step on subsequent runs.
SEPOLIA_BRIDGE_ADDRESS=

# Optional. Push Chain address that will receive the bridged funds.
# Defaults to the EOA derived from PRIVATE_KEY.
PUSH_RECIPIENT=

# Optional override. Wei to bridge. Defaults to 0.0001 ETH.
BRIDGE_AMOUNT_WEI=

# Optional override. Wei sent as fee on top of the bridge amount.
# Defaults to 0.005 ETH (~$15 worth — comfortable headroom over the
# ~$1 minimum gateway fee).
BRIDGE_FEE_WEI=
