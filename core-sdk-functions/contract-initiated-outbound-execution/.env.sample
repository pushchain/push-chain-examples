# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# .env is loaded automatically by the script via `import 'dotenv/config'`.
# Both variables are REQUIRED.

# Push native EOA private key. The wallet must be funded with at least 5 PC on
# Push Donut Testnet (covers UGPC protocol fee + gas to call dispatchOutbound).
# Same key you used to deploy the contract.
PUSH_PRIVATE_KEY=

# Address of a deployed MinimalContractInitiatedExecutor on Push Donut Testnet.
# Optional — leave blank on the first run and the script will offer to deploy
# one and write the resulting address back here automatically. If you'd rather
# deploy with Foundry yourself, use `forge create` (see README.md) and paste
# the resulting address here.
CONTRACT_ADDRESS=

# Optional override for the PC value sent as `msg.value` with dispatchOutbound.
# This must cover BOTH the UGPC protocol fee AND the destination-chain gasFee
# (which UGPC quotes from `gasLimit`). Defaults to 8 PC, which has headroom
# over observed minimums (BNB / Solana outbound: ~5.2 PC).
PROTOCOL_FEE_PC=

# Optional override for the gas limit reserved on the destination chain for
# executing `payload`. UGPC uses this to compute the destination-chain gasFee
# portion of msg.value. Defaults to 200000 — ample for `increment()` on the
# BNB counter (~30k actual). Bump for heavier target functions.
#
# Important: do NOT pass 0. UGPC quotes gasFee = quoteFor(gasLimit); a 0
# gasLimit makes that quote revert without data, surfacing as "missing revert
# data" in ethers.
GAS_LIMIT=
