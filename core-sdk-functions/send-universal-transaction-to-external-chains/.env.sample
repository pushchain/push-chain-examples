# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# .env is loaded automatically by the script via `import 'dotenv/config'`.
# Optional — if unset, the script generates a fresh wallet on each run and
# prints the private key so you can save it. CEAs derive deterministically
# from this key, so re-runs must use the same value to reach funded CEAs.

# Push native EOA private key. Fund with at least 10 PC for Route 2 demos
# (BNB Testnet target ≥ 10 PC; Solana Devnet target ≥ 10 PC since SVM outbound
# alone needs ~5.2 PC).
PUSH_PRIVATE_KEY=
