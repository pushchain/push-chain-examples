# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Push: ≥ 10 PC on YOUR EOA for the first run (deploys + funds the contract).
# After the contract is funded with 8 PC of internal balance, subsequent
# runs only need PC for the gas of the kickOff call (~0.05 PC).

# Hex private key — the Push EOA that deploys the dispatcher and triggers
# kickOff. NOT used for any external-chain action. The contract pays UGPC
# fees from its OWN balance, not from your EOA.
PRIVATE_KEY=

# Optional. Set to skip the Push deployment step.
ROUNDTRIP_DISPATCHER_ADDRESS=

# Optional override. PC the contract forwards to UGPC per kickOff.
# Defaults to 8 PC (comfortable headroom; UGPC's surplus refunds back into
# the contract via receive(), so balance stabilizes over time).
KICKOFF_PROTOCOL_FEE_PC=
