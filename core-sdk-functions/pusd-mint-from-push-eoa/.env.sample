# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# .env is loaded automatically by the script via `import 'dotenv/config'`.
# Optional — if unset, the script generates a fresh wallet on each run and
# prints the private key so you can save it. Re-runs must reuse the same key
# to mint into the same Push account.

# Push native EOA private key. Fund with:
#   • Some PC for gas — https://faucet.push.org/
#   • USDT on Donut (≥ the amount you want to deposit). Path B does NOT bridge —
#     the token must already be on Donut. The easiest way to get USDT.eth /
#     USDT.sol / USDT.bsc / USDT.base / USDT.arb (and the matching USDC origins)
#     onto Donut is the official Push Bridge UI: https://bridge.push.org/
#     Alternatively, run ../pusd-mint-from-external-chain (programmatic path).
PUSH_PRIVATE_KEY=
