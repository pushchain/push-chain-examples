# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Both required values can be a single private key — the same EOA is used
# on Sepolia (to deploy + call the dispatcher) and on Push Chain (to deploy
# the counter target). Fund the wallet with ≥ 0.05 Sepolia ETH and ≥ 1 PC.

# Hex private key — used on BOTH chains.
PRIVATE_KEY=

# Optional. Set to skip the Sepolia deployment step.
SEPOLIA_DISPATCHER_ADDRESS=

# Optional. Set to skip the Push counter deployment step.
PUSH_COUNTER_ADDRESS=

# Optional override. Sepolia gateway charges a small fee (~$1 worth of ETH)
# for the inbound dispatch. Defaults to 0.005 ETH which has comfortable
# headroom over observed minimums. Will be REFUNDED to revertRecipient on
# revert; surplus is kept by the gateway.
INBOUND_FEE_ETH=
