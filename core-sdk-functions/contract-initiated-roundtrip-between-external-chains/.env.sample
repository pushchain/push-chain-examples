# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Push: ≥ 12 PC for first run (deploy + 8 PC contract fund). Subsequent
# runs use the contract's balance — UGPC refunds the surplus per outbound.

PRIVATE_KEY=

# Optional. Skips the deploy.
CASCADE_CONTRACT_ADDRESS=

# Optional override. PC the contract forwards to UGPC for the BNB outbound.
# The Solana outbound consumes whatever PC the contract holds at execution
# time (up to half its balance — UGPC refunds surplus). Defaults to 8 PC.
KICKOFF_PROTOCOL_FEE_PC=
