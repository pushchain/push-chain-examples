# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Push: ≥ 10 PC for first run (deploy + 1.5 PC fund). Subsequent runs use the
# contract's balance.
# BNB Testnet: ≥ 0.05 BNB on the contract's CEA (one-time, faucet to the
# CEA address printed by the runner).

PRIVATE_KEY=

# Optional. Skips the deploy.
ROUNDTRIP_DISPATCHER_ADDRESS=

# Optional override. PC the contract forwards to UGPC. Defaults to 8 PC.
KICKOFF_PROTOCOL_FEE_PC=

# Optional override. 32-byte tag stored on the request. Defaults to a hash
# of "demo-tag".
REQUEST_TAG=
