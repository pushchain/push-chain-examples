# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Same private key used on Sepolia (deploy + call) and Push (deploy vault).
# Sepolia: ≥ 0.05 ETH (deploys EthereumInboundWithFunds + bridge fee per call).
# Push: ≥ 1 PC (deploys PushVault).

PRIVATE_KEY=

# Optional. Skips deployment steps on subsequent runs.
SEPOLIA_INBOUND_ADDRESS=
PUSH_VAULT_ADDRESS=

# Optional. Push beneficiary address recorded by the vault. Defaults to the
# EOA derived from PRIVATE_KEY.
BENEFICIARY=

# Optional override. Wei to bridge (the bridged amount becomes the value of
# the inner call to PushVault.deposit). Defaults to 0.0001 ETH.
BRIDGE_AMOUNT_WEI=

# Optional override. Wei sent on top of bridge amount to cover the gateway
# fee. Defaults to 0.005 ETH.
BRIDGE_FEE_WEI=
