# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# Push: ≥ 10 PC for first run (deploys + funds the contract).
# pBNB on Push: ≥ the BRIDGE_AMOUNT_WEI you intend to use. Get pBNB by
#   bridging BNB testnet → Push first (e.g., via the Push bridge UI in
#   apps/bridge or via a cross-chain Route 1 inbound). The contract MUST
#   hold the pBNB before kickoff — UGPC pulls via transferFrom.

PRIVATE_KEY=

# Optional. Set to skip the deploy.
PUSH_OUTBOUND_ADDRESS=

# Optional override. PC the contract forwards to UGPC. Defaults to 8 PC.
KICKOFF_PROTOCOL_FEE_PC=

# Optional override. pBNB amount to bridge (in wei). Defaults to 0.0001 BNB
# equivalent (= 100_000_000_000_000 wei).
BRIDGE_AMOUNT_WEI=

# Optional override. How much of the bridged native to forward as msg.value
# in the inner call to the destination contract. Defaults to 0 (just credit
# CEA balance, don't pass value to inner call).
DESTINATION_CALL_VALUE_WEI=
